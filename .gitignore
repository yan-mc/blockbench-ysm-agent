# runtime
workspace/
dist/
node_modules/
*.log
# 测试证据日志是有意保留的（覆盖上面的 *.log）
!docs/test-evidence/*.log

# python 缓存（如 tools/__pycache__）
__pycache__/
*.pyc

# archived test / reference material (kept on disk, never distributed)
_archive/

# upstream clones (keep out of VCS; re-clone per research docs)
vendor/

# generated previews（仅根目录；docs/artifacts 保留为验收证据）
/artifacts/

# isolated in-game validation environment (Forge/YSM/assets/world) and release artifacts
game-test/
release/

# local scratch prompt (not part of the deliverable)
临时文件.txt


# media build outputs
media/_tts/
media/frames/
media/*.mp4
media/*.wav
media/*.log

# 参考图是搜索下载的第三方版权素材，**只留在本地，绝不分发**
models/*/refs/
# T1/T2 分层产物（来自 ComfyUI，体积大且是派生物）
models/*/seg/

# 运行时工作目录（Chromium 缓存 / 渲染中间产物 / 导出包），不进版本库
models/*/.bb/
models/*/artifacts/
models/*/exports/
models/*/checkpoints/
models/*/logs/

# 全新用户验收跑出来的模型包（保留产物，但这份是过程证据，随来源变化）
models/*/sakiko-fresh-acceptance/

# 参考模型语料（来自用户本机 MC 安装，第三方版权，只本地用）
models/*/refcorpus/

# 语料库（含 169 个解码后的现代 YSM 模型、女仆/舰娘模型）——第三方版权，只本地用
material/
tools/ysmparser/

# 子智能体语料分析的中间产物
tools/curve/out_*.json

# 子智能体的分析中间产物
work/

# 宣传片生成中间产物（可重生成，不提交）
media/_promo_*/
media/_tts_test.mp3
media/__pycache__/
