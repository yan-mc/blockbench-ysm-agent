{
  "name": "@local/dsh-blockbench-agent",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "dsh Host plugin: semantic Blockbench modeling/texturing tools with headless render feedback",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/ws-server.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/*.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/cordis": "*"
  }
}



